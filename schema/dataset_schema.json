{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EV Battery Component",
  "type": "object",
  "required": ["id", "component_type", "manufacturer", "image_path", "source_url", "license"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z]+_[0-9]{4,}$" },
    "component_type": { "type": "string", "enum": ["cell", "connector", "bms"] },
    "manufacturer": { "type": "string" },
    "model": { "type": "string" },
    "image_path": { "type": "string" },
    "source_url": { "type": "string" },
    "license": { "type": "string" },
    "notes": { "type": "string" },

    "car_brand": { "type": "string" },
    "cell_supplier": { "type": "string" },
    
    "format": { "type": "string" },
    "voltage_V": { "type": "number" },
    "capacity_mAh": { "type": "number" },

    "connector_type": { "type": "string" },
    "current_rating_A": { "type": "number" },
    
    "features": { "type": "array", "items": { "type": "string" } },
    "supports_cell_count": { "type": "integer" },
    
    "chemistry": { "type": "string" },
    "date_added": { "type": "string", "format": "date" },
    "diameter_mm": { "type": "number" },
    "energy_Wh": { "type": "number" },
    "height_mm": { "type": "number" },
    "special_features": { "type": "array", "items": { "type": "string" } },
    "vehicle_models": { "type": "array", "items": { "type": "string" } },
    
    "part_series": { "type": "string" },
    "voltage_rating_V": { "type": "number" }
  },
  "additionalProperties": false
}