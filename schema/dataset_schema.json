{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CellBase Component Entry",
  "description": "Schema for a single EV battery component metadata entry in the CellBase dataset",
  "type": "object",
  "required": ["id", "component_type", "manufacturer"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique component identifier"
    },
    "component_type": {
      "type": "string",
      "enum": ["cells", "bms", "connectors", "cables", "busbars", "casings", "hardware"],
      "description": "One of the seven defined component categories"
    },
    "manufacturer": {
      "type": "string",
      "description": "Component manufacturer name"
    },
    "model": {
      "type": "string",
      "description": "Component model or part number"
    },
    "specs": {
      "type": ["object", "string", "null"],
      "description": "Technical specifications as key-value pairs"
    },
    "image_path": {
      "type": ["string", "null"],
      "description": "Relative path to component image within /static/"
    },
    "source_url": {
      "type": ["string", "null"],
      "description": "URL of the original data and image source"
    },
    "license": {
      "type": ["string", "null"],
      "description": "Usage rights of the source material"
    },
    "notes": {
      "type": ["string", "null"],
      "description": "Additional free-text context"
    },
    "date_added": {
      "type": ["string", "null"],
      "description": "Date entry was added (YYYY-MM-DD)"
    }
  },
  "additionalProperties": true
}